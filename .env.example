# Skopiuj jako .env (uzywane tylko przy lokalnym docker compose):
#   cp .env.example .env

# Adres wynikow wyszukiwania na otodom.pl - ze wszystkimi filtrami.
# Ustaw filtry w przegladarce i skopiuj URL z paska adresu.
SEARCH_URL='https://www.otodom.pl/pl/wyniki/sprzedaz/mieszkanie,3-pokoje/warszawa'

# Webhook Discorda w formacie HTTPS (nie apprise!).
# Discord -> Ustawienia kanalu -> Integracje -> Webhooki -> Kopiuj URL.
DISCORD_WEBHOOK_URL='https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN'

# true = powiadom o wszystkich ofertach juz przy pierwszym uruchomieniu.
# false = pierwsze uruchomienie tylko zapisuje stan, bez zalewania kanalu.
NOTIFY_ON_FIRST_RUN=false

# Harmonogram w formacie cron (5 pol).
CRON_SCHEDULE='0 * * * *'

TZ='Europe/Warsaw'
